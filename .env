# Event source for the bridge: simulator | autodarts | replay
SOURCE=simulator

# Only used when SOURCE=autodarts
BOARD_URL=http://192.168.120.40:3180

# Only used when SOURCE=replay
REPLAY_FILE=recon/captures/live.ndjson
REPLAY_SPEED=1

# Port the scoreboard is served on
WEB_PORT=8099

# Enable achievements that depend on dart coordinates. Leave at 0 until the
# board's throw payload is understood; see recon/FINDINGS.md.
COORDS_ENABLED=0
