# Event source for the bridge: simulator | autodarts | replay
SOURCE=simulator

# Only used when SOURCE=autodarts. Point this at the fake board
# (http://fakeboard:3180 in compose, http://localhost:3180 locally) to run the
# whole stack without hardware; see packages/fakeboard.
BOARD_URL=http://localhost:3180

# Fake board, started with: docker compose --profile fake up
FAKE_BOARD_PORT=3180
FAKE_MOTION=0

# Only used when SOURCE=replay
REPLAY_FILE=recon/captures/live.ndjson
REPLAY_SPEED=1

# Port the scoreboard is served on
WEB_PORT=8099

# Enable achievements that depend on dart coordinates. Leave at 0 until the
# board's throw payload is understood; see recon/FINDINGS.md.
COORDS_ENABLED=0
