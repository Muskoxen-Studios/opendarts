# Shared image for the bridge and the game server.
# Node runs the TypeScript sources directly via type stripping, so there is no
# build step and no compiled output to keep in sync.
FROM node:24-alpine

WORKDIR /app
ENV NODE_ENV=production

# Install workspace dependencies first so this layer caches across code changes.
COPY package.json package-lock.json ./
COPY packages/schema/package.json  packages/schema/
COPY packages/engine/package.json  packages/engine/
COPY packages/stats/package.json   packages/stats/
COPY packages/bridge/package.json  packages/bridge/
COPY packages/server/package.json  packages/server/
RUN npm ci --omit=dev --ignore-scripts

COPY packages/schema/src packages/schema/src
COPY packages/engine/src packages/engine/src
COPY packages/stats/src  packages/stats/src
COPY packages/bridge/src packages/bridge/src
COPY packages/server/src packages/server/src

# Overridden per service in docker-compose.yml.
CMD ["node", "packages/server/src/main.ts"]
