{
  "name": "darts",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p packages/frontend/tsconfig.json --noEmit",
    "dev:bridge": "node --watch packages/bridge/src/main.ts",
    "dev:fakeboard": "node --watch packages/fakeboard/src/main.ts",
    "dev:detector": "python3 -B services/detector/main.py --source synthetic",
    "test:detector": "python3 -B -m unittest discover -s services/detector -p 'test_*.py'",
        "detector:generate": "node scripts/generate-detection-dataset.mjs",
        "detector:evaluate": "python3 -B services/detector/benchmark.py evaluate",
        "detector:tune": "python3 -B services/detector/benchmark.py tune",
    "test:native": "node scripts/test-native.mjs",
    "check:native": "npm run check && npm run test:detector && npm run test:native",
    "dev:server": "node --watch packages/server/src/main.ts",
    "dev:frontend": "npm -w @darts/frontend run dev",
    "achievements:backfill": "node packages/server/src/scripts/backfill.ts",
    "build": "npm -w @darts/frontend run build",
    "check": "npm run typecheck && npm test",
    "dev:desktop": "npm -w @darts/desktop run start",
    "package:prepare": "node scripts/package/prepare.mjs",
    "package": "npm run package:prepare && electron-builder --projectDir build/app --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  }
}